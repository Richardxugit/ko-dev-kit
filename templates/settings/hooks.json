{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      { "command": "node .cursor/hooks/privacy-block.cjs" }
    ],
    "beforeTabFileRead": [
      { "command": "node .cursor/hooks/privacy-block.cjs" }
    ],
    "beforeShellExecution": [
      { "command": "node .cursor/hooks/privacy-block.cjs" },
      { "command": "node .cursor/hooks/safety-guard.cjs" }
    ],
    "beforeMCPExecution": [
      { "command": "node .cursor/hooks/privacy-block.cjs" }
    ],
    "postToolUse": [
      { "command": "node .cursor/hooks/edit-lint.cjs", "matcher": "Write", "timeout": 10 },
      { "command": "node .cursor/hooks/grep-negative.cjs", "matcher": "Grep", "timeout": 5 },
      { "command": "node .cursor/hooks/context-usage.cjs", "timeout": 5 },
      { "command": "node .cursor/hooks/session-ledger.cjs", "timeout": 5 }
    ],
    "afterAgentResponse": [
      { "command": "node .cursor/hooks/context-usage.cjs", "timeout": 5 },
      { "command": "node .cursor/hooks/session-ledger.cjs", "timeout": 5 }
    ],
    "stop": [
      { "command": "node .cursor/hooks/session-ledger.cjs", "timeout": 5 }
    ]
  }
}
